generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev (zero setup), same as the sibling Evo Services app.
  // Swap to postgresql + a real DATABASE_URL before this is hosted anywhere.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE
  // Does the turnovers: works a schedule of cleans on site, records stock
  // counts. The equivalent of Evo Services' FIELD_EMPLOYEE.
  CLEANER
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(CLEANER)
  // Only meaningful for CLEANER. Snapshotted onto Invoice.hourlyRate at
  // generation time (see src/lib/invoices.ts), so changing this later never
  // rewrites a past invoice.
  hourlyRate     Float?
  assignedCleans Clean[]    @relation("CleanAssignee")
  createdCleans  Clean[]    @relation("CleanCreator")
  cleanLogs      CleanLog[]
  invoices       Invoice[]
  laundryLoads   LaundryLoad[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// The property owner/management client an Evo Stays portfolio belongs to.
// This app is operated by a management company on the client's behalf --
// there's no client login, just a contact record staff manage, same role
// Client plays in the sibling Evo Services app.
model Client {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  notes      String?
  // Profile photo -- see src/lib/profilePhotos.ts. Optional; shows an
  // initials placeholder until one is set.
  photoPath  String?
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  COTTAGE
  OTHER
}

// One short-let unit. Sized by what actually drives a turnover -- bed and
// bath count, and how many guests it sleeps -- rather than floor area, which
// is what the sibling app's quoting model needed.
model Property {
  id            String               @id @default(cuid())
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  // The listing name ("Riverside Loft"). Falls back to a shortened address
  // when not set -- see src/lib/address.ts.
  name          String?
  address       String
  // Set when the address was picked from an autocomplete rather than typed
  // freehand. Null if never matched to a location.
  latitude      Float?
  longitude     Float?
  type          PropertyType         @default(APARTMENT)
  bedrooms      Int?
  bathrooms     Int?
  maxOccupancy  Int?
  // Preset access-point keys (e.g. ["KEY_SAFE","LIFT"]) -- a JSON string
  // array since SQLite/Prisma has no native scalar list type here.
  accessOptions Json?
  // Free text for anything the presets don't cover: key safe codes, alarm
  // codes, parking, which bin day. The cleaner reads this on site.
  accessNotes   String?
  notes         String?
  // Floor on billable hours per visit, e.g. 2 -- a cleaner who finishes in
  // 40 minutes because the property was left tidy still gets paid for the
  // minimum, so there's no incentive to rush. Null means the toggle is off
  // and invoices bill actual check-in/check-out time only. See
  // generateInvoices in src/lib/invoices.ts.
  minBillableHours Float?
  images        PropertyImage[]
  cleans        Clean[]
  stockLevels   PropertyStockLevel[]
  invoices      Invoice[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([clientId])
}

// A photo of the property itself. One per property can be flagged as the
// cover shot, shown on the portfolio list.
model PropertyImage {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  path       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

enum CleanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// One turnover: a job at a property, for a cleaner, on a date. The cleaner
// works it check-in -> check-out, which produces the CleanLog below.
//
// Assignment is also what a cleaner's access is derived from: they can see a
// property only where they hold a Clean (see cleanerPropertyWhere in
// src/lib/authz.ts), since access notes carry key safe codes.
model Clean {
  id           String      @id @default(cuid())
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId   String
  // Null when auto-assignment found nobody -- shows as "Unassigned" until
  // an admin picks someone.
  assignedTo   User?       @relation("CleanAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  createdBy    User        @relation("CleanCreator", fields: [createdById], references: [id])
  createdById  String
  instructions String?
  status       CleanStatus @default(PENDING)
  // Null means created but not yet given a slot.
  scheduledFor DateTime?
  // How many guests just stayed -- the input the stock estimate is built
  // from (see src/lib/stockEstimate.ts). Optional: without it there's simply
  // no estimate, the same as an item with no usagePerGuestNight configured.
  guestCount   Int?
  // Set on check-in; copied onto the CleanLog at check-out (the log doesn't
  // exist yet at check-in time).
  arrivedAt    DateTime?
  log          CleanLog?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([propertyId])
  @@index([assignedToId])
  @@index([scheduledFor])
}

// The permanent record of a completed turnover. Separate from Clean so the
// job (which can be rescheduled, reassigned, cancelled) stays distinct from
// what actually happened on site.
model CleanLog {
  id           String          @id @default(cuid())
  clean        Clean           @relation(fields: [cleanId], references: [id], onDelete: Cascade)
  cleanId      String          @unique
  recordedBy   User            @relation(fields: [recordedById], references: [id])
  recordedById String
  note         String?
  arrivedAt    DateTime?
  departedAt   DateTime?
  photos       CleanPhoto[]
  stockUsage   StockUsageLog[]
  // At most one -- a visit can only ever be billed once, even across
  // separate invoice generation runs. See src/lib/invoices.ts.
  invoiceLine  InvoiceLine?
  // Which laundrette drop-off this visit's dirty linen went out in, if any
  // -- a visit belongs to at most one load. SetNull (not Cascade) so
  // deleting a load frees its logs back to unlinked rather than losing the
  // visit record itself.
  laundryLoad   LaundryLoad? @relation(fields: [laundryLoadId], references: [id], onDelete: SetNull)
  laundryLoadId String?
  createdAt    DateTime        @default(now())
}

enum PhotoStage {
  BEFORE
  AFTER
}

// Before/after shots from a turnover. Stored under the same
// storage/property-photos/{propertyId}/ root as PropertyImage, so the single
// access check in /api/photos covers both.
model CleanPhoto {
  id        String     @id @default(cuid())
  log       CleanLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  path      String
  stage     PhotoStage
  createdAt DateTime   @default(now())

  @@index([logId])
}

// The business-wide catalogue of consumables: loo roll, bin bags, welcome
// tea/coffee, cleaning products. active mirrors Service in the sibling app --
// items with usage history are hidden rather than deleted, see the guard in
// src/app/admin/stock-items/actions.ts.
model StockItem {
  id                 String               @id @default(cuid())
  name               String               @unique
  // Free label for what's being counted -- "roll", "bottle", "sachet". Shown
  // next to the number, never used in arithmetic.
  unit               String?
  // Expected consumption per guest per night, e.g. 0.5 loo rolls. Optional --
  // an item with no rate set gets no auto-estimate, just today's "last known"
  // default. See src/lib/stockEstimate.ts.
  usagePerGuestNight Float?
  active             Boolean              @default(true)
  levels             PropertyStockLevel[]
  usage              StockUsageLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

// One item, one property: what should be on hand (parQty) and what actually
// is (onHandQty) right now. Configuring this is opt-in per property -- most
// won't have any rows yet, and the cleaner's stock step simply doesn't
// appear for a property with none (see the step logic in
// src/app/cleaner/cleans/[id]/page.tsx).
model PropertyStockLevel {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  stockItemId String
  parQty      Int
  onHandQty   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, stockItemId])
  @@index([propertyId])
}

// One item, one completed (or in-progress) visit: what the cleaner counted
// on site, plus anything they topped up from supplies they carry. restockedQty
// defaults to 0 rather than being required, so a business that only wants
// counts reported (someone else delivers later) and one where cleaners
// restock on the spot are both just this same row with a different number in
// it -- no separate flow for either.
//
// PropertyStockLevel.onHandQty is set to countedQty + restockedQty when this
// is recorded (see submitStockCounts), so this table is the audit trail
// behind that single current number.
model StockUsageLog {
  id           String    @id @default(cuid())
  log          CleanLog  @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId        String
  stockItem    StockItem @relation(fields: [stockItemId], references: [id])
  stockItemId  String
  countedQty   Int
  restockedQty Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([logId, stockItemId])
  @@index([logId])
}

enum InvoiceCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

// Business-wide setting, not per-cleaner: "how often do cleaner invoices go
// out". Single row -- id is always "singleton", never created twice. Only
// pre-fills the period offered when generating; a run can still cover any
// dates staff pick.
model BillingSettings {
  id        String         @id @default("singleton")
  cadence   InvoiceCadence @default(MONTHLY)
  updatedAt DateTime       @updatedAt
}

// One cleaner's earnings at one property for one period. Per-property, not
// per-cleaner-per-period, because each property belongs to a different
// Client (see Property.clientId) who needs their own cleaning cost visible
// on its own, not lumped in with unrelated properties. Who ultimately gets
// billed is derivable via property.client -- not duplicated here.
model Invoice {
  id          String        @id @default(cuid())
  cleaner     User          @relation(fields: [cleanerId], references: [id])
  cleanerId   String
  property    Property      @relation(fields: [propertyId], references: [id])
  propertyId  String
  periodStart DateTime
  periodEnd   DateTime
  // Copied from User.hourlyRate at generation time -- see the model comment
  // there for why.
  hourlyRate  Float
  totalHours  Float
  totalAmount Float
  // Pure record-keeping: an admin-set flag for "have we been paid for
  // this", not anything that processes an actual payment.
  paidAt      DateTime?
  lines       InvoiceLine[]
  createdAt   DateTime      @default(now())

  @@index([cleanerId])
  @@index([propertyId])
}

// One completed visit's contribution to an invoice. cleanLogId is unique --
// not just per-invoice but globally -- so the same visit can never end up on
// two invoices even if generation is run twice for overlapping periods.
// That uniqueness is what makes generation safe to re-run: it only ever
// picks up CleanLogs with no InvoiceLine yet.
model InvoiceLine {
  id         String   @id @default(cuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  cleanLog   CleanLog @relation(fields: [cleanLogId], references: [id])
  cleanLogId String   @unique
  arrivedAt  DateTime
  departedAt DateTime
  hours      Float
  amount     Float

  @@index([invoiceId])
}

// Proof that a laundrette drop-off happened, plus its cost -- so laundry
// spend is auditable the same way cleaning invoices are. Covers however
// many completed visits' dirty linen went out together in one trip (see
// `logs` below), not a strict one-to-one with a single Clean. Either a
// cleaner or admin/office staff can create one -- see recordedBy.
model LaundryLoad {
  id           String     @id @default(cuid())
  cost         Float
  // One ticket photo, same storage convention as PropertyImage/CleanPhoto
  // (see src/lib/uploads.ts) but under its own storage root, since a load
  // isn't scoped to a single property the way those are.
  receiptPath  String
  recordedBy   User       @relation(fields: [recordedById], references: [id])
  recordedById String
  logs         CleanLog[]
  createdAt    DateTime   @default(now())

  @@index([recordedById])
}
