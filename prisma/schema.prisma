generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev (zero setup), same as the sibling Evo Services app.
  // Swap to postgresql + a real DATABASE_URL before this is hosted anywhere.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE
  // Does the turnovers: works a schedule of cleans on site, records stock
  // counts. The equivalent of Evo Services' FIELD_EMPLOYEE.
  CLEANER
  // A short-let owner/host. Signs in to see their own portfolio only.
  CLIENT
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(CLEANER)
  // Set only for CLIENT logins: which portfolio this person can see. Kept as
  // a nullable FK on User (rather than auth fields on Client) so there is one
  // identity table and one authorize() lookup, and so a management company
  // can later have several logins against the same Client with no migration.
  client         Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String?
  assignedCleans Clean[]    @relation("CleanAssignee")
  createdCleans  Clean[]    @relation("CleanCreator")
  cleanLogs      CleanLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([clientId])
}

// The host/owner an Evo Stays portfolio belongs to. Contact record first;
// gains portal logins via User.clientId when one is issued.
model Client {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  notes      String?
  // Profile photo -- see src/lib/profilePhotos.ts. Optional; shows an
  // initials placeholder until one is set.
  photoPath  String?
  properties Property[]
  users      User[]
  // Cleans this client asked for themselves, rather than staff scheduling.
  requested  Clean[]    @relation("CleanRequestedBy")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  COTTAGE
  OTHER
}

// One short-let unit. Sized by what actually drives a turnover -- bed and
// bath count, and how many guests it sleeps -- rather than floor area, which
// is what the sibling app's quoting model needed.
model Property {
  id            String          @id @default(cuid())
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  // The listing name ("Riverside Loft"). Falls back to a shortened address
  // when not set -- see src/lib/address.ts.
  name          String?
  address       String
  // Set when the address was picked from an autocomplete rather than typed
  // freehand. Null if never matched to a location.
  latitude      Float?
  longitude     Float?
  type          PropertyType    @default(APARTMENT)
  bedrooms      Int?
  bathrooms     Int?
  maxOccupancy  Int?
  // Preset access-point keys (e.g. ["KEY_SAFE","LIFT"]) -- a JSON string
  // array since SQLite/Prisma has no native scalar list type here.
  accessOptions Json?
  // Free text for anything the presets don't cover: key safe codes, alarm
  // codes, parking, which bin day. The cleaner reads this on site.
  accessNotes   String?
  notes         String?
  images        PropertyImage[]
  cleans        Clean[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId])
}

// A photo of the property itself. One per property can be flagged as the
// cover shot, shown on the portfolio list.
model PropertyImage {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  path       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

enum CleanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// One turnover: a job at a property, for a cleaner, on a date. The cleaner
// works it check-in -> check-out, which produces the CleanLog below.
//
// Assignment is also what a cleaner's access is derived from: they can see a
// property only where they hold a Clean (see cleanerPropertyWhere in
// src/lib/authz.ts), since access notes carry key safe codes.
model Clean {
  id                  String      @id @default(cuid())
  property            Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId          String
  // Null when auto-assignment found nobody -- shows as "Unassigned" until
  // an admin picks someone.
  assignedTo          User?       @relation("CleanAssignee", fields: [assignedToId], references: [id])
  assignedToId        String?
  // Null for a clean the client requested themselves; there's no staff
  // member to credit until someone picks it up.
  createdBy           User?       @relation("CleanCreator", fields: [createdById], references: [id])
  createdById         String?
  requestedByClient   Client?     @relation("CleanRequestedBy", fields: [requestedByClientId], references: [id], onDelete: Cascade)
  requestedByClientId String?
  // What the client said when requesting. Shown to staff, never edited by them.
  clientNote          String?
  instructions        String?
  status              CleanStatus @default(PENDING)
  // Null means requested but not yet given a slot.
  scheduledFor        DateTime?
  // Set on check-in; copied onto the CleanLog at check-out (the log doesn't
  // exist yet at check-in time).
  arrivedAt           DateTime?
  log                 CleanLog?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([propertyId])
  @@index([assignedToId])
  @@index([scheduledFor])
}

// The permanent record of a completed turnover. Separate from Clean so the
// job (which can be rescheduled, reassigned, cancelled) stays distinct from
// what actually happened on site.
model CleanLog {
  id           String       @id @default(cuid())
  clean        Clean        @relation(fields: [cleanId], references: [id], onDelete: Cascade)
  cleanId      String       @unique
  recordedBy   User         @relation(fields: [recordedById], references: [id])
  recordedById String
  note         String?
  arrivedAt    DateTime?
  departedAt   DateTime?
  photos       CleanPhoto[]
  createdAt    DateTime     @default(now())
}

enum PhotoStage {
  BEFORE
  AFTER
}

// Before/after shots from a turnover. Stored under the same
// storage/property-photos/{propertyId}/ root as PropertyImage, so the single
// access check in /api/photos covers both.
model CleanPhoto {
  id        String     @id @default(cuid())
  log       CleanLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  path      String
  stage     PhotoStage
  createdAt DateTime   @default(now())

  @@index([logId])
}
