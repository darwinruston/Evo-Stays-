generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev (zero setup), same as the sibling Evo Services app.
  // Swap to postgresql + a real DATABASE_URL before this is hosted anywhere.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE
  // Does the turnovers: works a schedule of cleans on site, records stock
  // counts. The equivalent of Evo Services' FIELD_EMPLOYEE.
  CLEANER
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(CLEANER)
  // Only meaningful for CLEANER. Snapshotted onto Invoice.hourlyRate at
  // generation time (see src/lib/invoices.ts), so changing this later never
  // rewrites a past invoice.
  hourlyRate     Float?
  // Only meaningful for CLEANER. Caps how far into the future "My cleans"
  // (src/app/cleaner/page.tsx) shows work -- some cleaners want to see their
  // whole run of upcoming bookings, others find a long tail of far-future
  // dates just noise. Null (the default) shows everything, same as an unset
  // Property.syncHorizonDays never cutting anything off. Never bounds the
  // past -- overdue and completed work always still shows.
  scheduleHorizonDays Int?
  // Whether notifications (see Notification below) are also emailed, on top
  // of always appearing in the app. Only has any effect once SMTP is
  // configured -- see src/lib/email.ts.
  emailNotifications Boolean   @default(true)
  notifications  Notification[]
  reportedIssues Issue[]       @relation("IssueReporter")
  resolvedIssues Issue[]       @relation("IssueResolver")
  assignedCleans Clean[]       @relation("CleanAssignee")
  createdCleans  Clean[]       @relation("CleanCreator")
  cleanLogs      CleanLog[]
  invoices       Invoice[]
  laundryLoads   LaundryLoad[]
  designatedProperties PropertyCleaner[]
  unavailability CleanerUnavailability[]
  auditLogs      AuditLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// A permanent record of who changed what, for the handful of entities where
// "who did this and when" actually matters operationally later: clean
// reassignment/rescheduling/status changes, property/client edits and
// deletions, a cleaner's pay rate or removal, and Hostify API key changes.
// Deliberately not everything -- stock counts, laundry, photo uploads stay
// unlogged; this is for changes worth being able to answer for, not a
// request log. See src/lib/audit.ts.
//
// actorId is nullable with onDelete: SetNull, not Cascade -- deleting the
// user who did something shouldn't erase the record that they did it.
// entityId is a plain string, not a relation, for the same reason in the
// other direction: the audited row itself (a Clean, a Property...) can be
// deleted while its history survives -- the summary is written to stand on
// its own rather than depend on a join that might no longer resolve.
model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum NotificationKind {
  // To a cleaner: a clean is now theirs (new, reassigned to them, or
  // reinstated after being cancelled).
  CLEAN_ASSIGNED
  // To a cleaner: a clean they held has moved to someone else.
  CLEAN_UNASSIGNED
  CLEAN_RESCHEDULED
  CLEAN_CANCELLED
  // To staff: a sync created a clean that auto-assign couldn't place, so it
  // sits Unassigned until someone picks a cleaner.
  CLEAN_NEEDS_CLEANER
  // To staff: someone reported a problem at a property (see Issue).
  ISSUE_REPORTED
  // To whoever reported it: staff have marked it resolved.
  ISSUE_RESOLVED
  // To staff and the assigned cleaner: a same-day turnover isn't finished
  // and the next guests are due soon.
  TURNOVER_AT_RISK
}

// One thing a specific person should know about, shown in their in-app
// Notifications list (and emailed too, when SMTP is configured and they
// haven't opted out -- see User.emailNotifications and src/lib/notify.ts).
// Unlike AuditLog, this is addressed to someone and has a read state; it's
// "what changed that affects you", not the permanent record of who did what.
//
// title/body are written to stand on their own, same reasoning as
// AuditLog.summary -- the clean behind a notification can be deleted
// afterwards, and the message should still make sense. href may then 404.
model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  // Where following the notification should land -- a path inside the
  // recipient's own area (/cleaner/... or /admin/...). Null when there's
  // nowhere useful to go (e.g. a clean that's no longer theirs).
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// The property owner/management client an Evo Stays portfolio belongs to.
// This app is operated by a management company on the client's behalf --
// there's no client login, just a contact record staff manage, same role
// Client plays in the sibling Evo Services app.
model Client {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  notes      String?
  // Profile photo -- see src/lib/profilePhotos.ts. Optional; shows an
  // initials placeholder until one is set.
  photoPath  String?
  // AES-256-GCM ciphertext (see src/lib/encryption.ts), never plaintext -- a
  // live Hostify key grants ongoing read access to this client's whole
  // Hostify account, not just one property. Null means Hostify isn't
  // connected for this client. One key per client (a Hostify account),
  // covering every property under it -- see Property.hostifyListingId.
  hostifyApiKey String?
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  COTTAGE
  OTHER
}

// One short-let unit. Sized by what actually drives a turnover -- bed and
// bath count, and how many guests it sleeps -- rather than floor area, which
// is what the sibling app's quoting model needed.
model Property {
  id               String               @id @default(cuid())
  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  // The listing name ("Riverside Loft"). Falls back to a shortened address
  // when not set -- see src/lib/address.ts.
  name             String?
  address          String
  // Set when the address was picked from an autocomplete rather than typed
  // freehand. Null if never matched to a location.
  latitude         Float?
  longitude        Float?
  type             PropertyType         @default(APARTMENT)
  bedrooms         Int?
  bathrooms        Int?
  maxOccupancy     Int?
  // Extra sleeping capacity already counted into maxOccupancy but not from
  // a bedroom -- a double sofa bed sleeping 2, say. Null/0 means no sofa
  // bed. A changeover needs it prepared when the booking's guest count runs
  // higher than maxOccupancy minus this, i.e. more guests than the
  // bedrooms alone sleep. See cleanPrep in src/lib/cleanPrep.ts.
  sofaBedSleeps    Int?
  // Preset access-point keys (e.g. ["KEY_SAFE","LIFT"]) -- a JSON string
  // array since SQLite/Prisma has no native scalar list type here.
  accessOptions    Json?
  // Free text for anything the presets don't cover: key safe codes, alarm
  // codes, parking, which bin day. The cleaner reads this on site.
  accessNotes      String?
  notes            String?
  // Floor on billable hours per visit, e.g. 2 -- a cleaner who finishes in
  // 40 minutes because the property was left tidy still gets paid for the
  // minimum, so there's no incentive to rush. Null means the toggle is off
  // and invoices bill actual check-in/check-out time only. See
  // generateInvoices in src/lib/invoices.ts.
  minBillableHours Float?
  // How far into the future calendar sync will create cleans for this
  // property's feeds, e.g. 31 -- a booking checking out further out than
  // that is simply skipped on this sync and picked up on a later one once
  // it's within range, rather than filling the schedule with cleans over a
  // year out. Null means no limit. Applies to every feed under this
  // property (one property can list on several platforms). See
  // syncCalendarFeed in src/lib/icalSync.ts.
  syncHorizonDays  Int?
  // The listing's standard guest check-in time, "HH:MM" (e.g. "15:00").
  // Only used when a synced booking arrives without a real time of its own
  // -- an all-day iCal event, or Hostify's date-only checkIn -- so a
  // same-day turnover can still show a "finish by" deadline instead of just
  // "guests arrive today". Null means unknown. See src/lib/turnover.ts.
  checkInTime      String?
  // Hostify listing id this property maps to -- a listing already aggregates
  // every channel (Airbnb, Vrbo, ...) into one reservation feed, unlike iCal
  // where each channel publishes its own separate URL, so this is a single
  // field rather than a one-to-many feed list. Unique: two properties on the
  // same listing would double-schedule every booking. Null means not
  // connected via Hostify. See src/lib/hostifySync.ts.
  //
  // String, not Int -- real Hostify listing ids run well past 2^53 (rules
  // out a JS number without silent rounding) and past 32-bit INT range too.
  // Never used numerically, only as an opaque id sent back to Hostify, so
  // there's no reason it needs to be one.
  hostifyListingId     String?   @unique
  hostifyLastSyncedAt  DateTime?
  hostifyLastSyncError String?
  images           PropertyImage[]
  cleans           Clean[]
  stockLevels      PropertyStockLevel[]
  invoices         Invoice[]
  calendarFeeds    PropertyCalendarFeed[]
  hostifyReservations SyncedHostifyReservation[]
  designatedCleaners PropertyCleaner[]
  issues           Issue[]
  checklistItems   PropertyChecklistItem[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([clientId])
}

// A photo of the property itself. One per property can be flagged as the
// cover shot, shown on the portfolio list.
model PropertyImage {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  path       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

enum CleanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// One turnover: a job at a property, for a cleaner, on a date. The cleaner
// works it check-in -> check-out, which produces the CleanLog below.
//
// Assignment is also what a cleaner's access is derived from: they can see a
// property only where they hold a Clean (see cleanerPropertyWhere in
// src/lib/authz.ts), since access notes carry key safe codes.
model Clean {
  id           String      @id @default(cuid())
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId   String
  // Null when auto-assignment found nobody -- shows as "Unassigned" until
  // an admin picks someone.
  assignedTo   User?       @relation("CleanAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  createdBy    User        @relation("CleanCreator", fields: [createdById], references: [id])
  createdById  String
  instructions String?
  status       CleanStatus @default(PENDING)
  // Null means created but not yet given a slot.
  scheduledFor DateTime?
  // How many guests just stayed -- the input the stock estimate is built
  // from (see src/lib/stockEstimate.ts). Optional: without it there's simply
  // no estimate, the same as an item with no usagePerGuestNight configured.
  guestCount   Int?
  // Set on check-in; copied onto the CleanLog at check-out (the log doesn't
  // exist yet at check-in time).
  arrivedAt    DateTime?
  log          CleanLog?
  // Set only when this clean was auto-created by a calendar sync rather
  // than scheduled by hand -- see PropertyCalendarFeed/SyncedBookingEvent.
  // Required by Prisma to declare the relation on both sides; nothing in
  // the app queries through it from this direction yet.
  syncedBookingEvent SyncedBookingEvent?
  // Same as syncedBookingEvent above, but for a Hostify-sourced reservation --
  // see SyncedHostifyReservation.
  syncedHostifyReservation SyncedHostifyReservation?
  issues       Issue[]
  // Set once people have been alerted that this clean is at risk of not
  // being finished before the next guests arrive (see checkAtRiskTurnovers
  // in src/lib/turnover.ts), so the scheduler doesn't re-alert on every
  // pass. Cleared whenever the clean is rescheduled -- a new date is a new
  // deadline, worth its own alert.
  atRiskNotifiedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([propertyId])
  @@index([assignedToId])
  @@index([scheduledFor])
}

// The permanent record of a completed turnover. Separate from Clean so the
// job (which can be rescheduled, reassigned, cancelled) stays distinct from
// what actually happened on site.
model CleanLog {
  id            String          @id @default(cuid())
  clean         Clean           @relation(fields: [cleanId], references: [id], onDelete: Cascade)
  cleanId       String          @unique
  recordedBy    User            @relation(fields: [recordedById], references: [id])
  recordedById  String
  note          String?
  arrivedAt     DateTime?
  departedAt    DateTime?
  photos        CleanPhoto[]
  stockUsage    StockUsageLog[]
  // At most one -- a visit can only ever be billed once, even across
  // separate invoice generation runs. See src/lib/invoices.ts.
  invoiceLine   InvoiceLine?
  // Which laundrette drop-off this visit's dirty linen went out in, if any
  // -- a visit belongs to at most one load. SetNull (not Cascade) so
  // deleting a load frees its logs back to unlinked rather than losing the
  // visit record itself.
  laundryLoad   LaundryLoad?    @relation(fields: [laundryLoadId], references: [id], onDelete: SetNull)
  laundryLoadId String?
  createdAt     DateTime        @default(now())
}

enum PhotoStage {
  BEFORE
  AFTER
}

// Before/after shots from a turnover. Stored under the same
// storage/property-photos/{propertyId}/ root as PropertyImage, so the single
// access check in /api/photos covers both.
model CleanPhoto {
  id        String     @id @default(cuid())
  log       CleanLog   @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId     String
  path      String
  stage     PhotoStage
  createdAt DateTime   @default(now())

  @@index([logId])
}

// The business-wide catalogue of consumables: loo roll, bin bags, welcome
// tea/coffee, cleaning products. active mirrors Service in the sibling app --
// items with usage history are hidden rather than deleted, see the guard in
// src/app/admin/stock-items/actions.ts.
model StockItem {
  id                 String               @id @default(cuid())
  name               String               @unique
  // Free label for what's being counted -- "roll", "bottle", "sachet". Shown
  // next to the number, never used in arithmetic.
  unit               String?
  // Expected consumption per guest per night, e.g. 0.5 loo rolls. Optional --
  // an item with no rate set gets no auto-estimate, just today's "last known"
  // default. See src/lib/stockEstimate.ts.
  usagePerGuestNight Float?
  active             Boolean              @default(true)
  levels             PropertyStockLevel[]
  usage              StockUsageLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

// One item, one property: what should be on hand (parQty) and what actually
// is (onHandQty) right now. Configuring this is opt-in per property -- most
// won't have any rows yet, and the cleaner's stock step simply doesn't
// appear for a property with none (see the step logic in
// src/app/cleaner/cleans/[id]/page.tsx).
model PropertyStockLevel {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  stockItemId String
  parQty      Int
  onHandQty   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, stockItemId])
  @@index([propertyId])
}

// A cleaner designated as the regular/preferred worker for a property.
// autoAssignCleaner (src/lib/autoAssign.ts) tries this pool first for a new
// clean, before falling back to its familiarity/load scoring across every
// cleaner -- so this is a strong preference, not a hard rule. More than one
// cleaner can be designated on the same property (a small cover/rotation
// pool), and the same cleaner can be designated on more than one property.
model PropertyCleaner {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  cleaner    User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  cleanerId  String
  // A flat fee agreed for this cleaner doing this property -- "always £80
  // for Saltdean", however long the visit takes. When set, invoices bill
  // this per completed visit instead of hours x hourly rate (see
  // generateInvoices in src/lib/invoices.ts). Null means paid by the hour.
  // Only affects invoices generated after it's set: each line snapshots the
  // fee it was billed at (InvoiceLine.flatFee).
  flatFee    Float?
  createdAt  DateTime @default(now())

  @@unique([propertyId, cleanerId])
  @@index([cleanerId])
}

// A day a cleaner has marked themselves unavailable. autoAssignCleaner
// (src/lib/autoAssign.ts) skips them entirely for a clean scheduled that
// day -- staff can still assign them by hand (CleanForm shows a warning
// when they do), this only changes what auto-assign guesses. Can't be
// created for a day the cleaner already has a clean scheduled -- see
// blockDay in src/app/cleaner/actions.ts.
model CleanerUnavailability {
  id        String   @id @default(cuid())
  cleaner   User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  cleanerId String
  // Local midnight of the blocked day -- compared via dayBounds, the same
  // convention autoAssignCleaner already uses for same-day load.
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([cleanerId, date])
}

// One item, one completed (or in-progress) visit: what the cleaner counted
// on site, plus anything they topped up from supplies they carry. restockedQty
// defaults to 0 rather than being required, so a business that only wants
// counts reported (someone else delivers later) and one where cleaners
// restock on the spot are both just this same row with a different number in
// it -- no separate flow for either.
//
// PropertyStockLevel.onHandQty is set to countedQty + restockedQty when this
// is recorded (see submitStockCounts), so this table is the audit trail
// behind that single current number.
model StockUsageLog {
  id           String    @id @default(cuid())
  log          CleanLog  @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId        String
  stockItem    StockItem @relation(fields: [stockItemId], references: [id])
  stockItemId  String
  countedQty   Int
  restockedQty Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([logId, stockItemId])
  @@index([logId])
}

enum InvoiceCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

// Business-wide setting, not per-cleaner: "how often do cleaner invoices go
// out". Single row -- id is always "singleton", never created twice. Only
// pre-fills the period offered when generating; a run can still cover any
// dates staff pick.
model BillingSettings {
  id        String         @id @default("singleton")
  cadence   InvoiceCadence @default(MONTHLY)
  updatedAt DateTime       @updatedAt
}

// One cleaner's earnings at one property for one period. Per-property, not
// per-cleaner-per-period, because each property belongs to a different
// Client (see Property.clientId) who needs their own cleaning cost visible
// on its own, not lumped in with unrelated properties. Who ultimately gets
// billed is derivable via property.client -- not duplicated here.
model Invoice {
  id          String        @id @default(cuid())
  cleaner     User          @relation(fields: [cleanerId], references: [id])
  cleanerId   String
  property    Property      @relation(fields: [propertyId], references: [id])
  propertyId  String
  periodStart DateTime
  periodEnd   DateTime
  // Copied from User.hourlyRate at generation time -- see the model comment
  // there for why.
  hourlyRate  Float
  totalHours  Float
  totalAmount Float
  // Pure record-keeping: an admin-set flag for "have we been paid for
  // this", not anything that processes an actual payment.
  paidAt      DateTime?
  lines       InvoiceLine[]
  createdAt   DateTime      @default(now())

  @@index([cleanerId])
  @@index([propertyId])
}

// One completed visit's contribution to an invoice. cleanLogId is unique --
// not just per-invoice but globally -- so the same visit can never end up on
// two invoices even if generation is run twice for overlapping periods.
// That uniqueness is what makes generation safe to re-run: it only ever
// picks up CleanLogs with no InvoiceLine yet.
model InvoiceLine {
  id         String   @id @default(cuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  cleanLog   CleanLog @relation(fields: [cleanLogId], references: [id])
  cleanLogId String   @unique
  arrivedAt  DateTime
  departedAt DateTime
  hours      Float
  amount     Float
  // True once staff have overridden the billed hours away from what
  // arrivedAt/departedAt (and any per-property minimum) would compute --
  // e.g. a visit with an obviously bad checkout timestamp. arrivedAt/
  // departedAt are left untouched (the real record of what happened); only
  // what's actually billed changes. See adjustInvoiceLineHours.
  // Set when this visit was billed at a flat fee rather than hours x rate
  // (see PropertyCleaner.flatFee): the agreed amount, snapshotted here so a
  // later change to the fee never rewrites an invoice already generated.
  // hours/arrivedAt/departedAt are still recorded as the real visit.
  flatFee    Float?
  adjusted   Boolean  @default(false)

  @@index([invoiceId])
}

// Proof that a laundrette drop-off happened, plus its cost -- so laundry
// spend is auditable the same way cleaning invoices are. Covers however
// many completed visits' dirty linen went out together in one trip (see
// `logs` below), not a strict one-to-one with a single Clean. Either a
// cleaner or admin/office staff can create one -- see recordedBy.
model LaundryLoad {
  id           String          @id @default(cuid())
  // Nullable -- the laundry company now invoices monthly rather than per
  // load, so there's no longer a per-load cost to enter. Kept (not dropped)
  // so loads recorded before that change keep showing what they cost.
  cost         Float?
  // Which launderette/facility the linen actually went to -- picked from
  // the LaundryFacility catalogue rather than typed fresh each time, since
  // a business only ever uses a handful of these on repeat.
  facility     LaundryFacility @relation(fields: [facilityId], references: [id])
  facilityId   String
  // Nullable -- the laundry company now collects from and drops back off at
  // the property directly, so there's no paper ticket to photograph any
  // more. Same reasoning as cost above: kept for loads recorded before the
  // change, just never set going forward.
  receiptPath  String?
  recordedBy   User            @relation(fields: [recordedById], references: [id])
  recordedById String
  logs         CleanLog[]
  createdAt    DateTime        @default(now())
  // Null while the linen is still out at the laundrette -- that's what
  // makes a property's "currently out" section self-closing: once this is
  // set, the load just drops out of that filtered view instead of needing
  // to be manually cleared away.
  collectedAt  DateTime?

  @@index([recordedById])
  @@index([facilityId])
}

// The catalogue of launderettes/facilities a business actually uses on
// repeat, so a load picks one instead of typing a name fresh each time.
// Same active-flag pattern as StockItem: a facility no longer used is
// deactivated (dropped from the picker for new loads) rather than deleted,
// since past loads still need to display which one they went to.
model LaundryFacility {
  id        String        @id @default(cuid())
  name      String        @unique
  active    Boolean       @default(true)
  loads     LaundryLoad[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// One row per platform a property is listed on (Airbnb, Vrbo, ...) --
// each publishes its own separate iCal URL for the same physical unit.
model PropertyCalendarFeed {
  id             String    @id @default(cuid())
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId     String
  label          String
  url            String
  lastSyncedAt   DateTime?
  lastSyncError  String?
  events         SyncedBookingEvent[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([propertyId])
}

// One row per iCal VEVENT ever seen on a feed, keyed by [feedId, externalUid]
// so re-syncing is idempotent -- a UID already seen is updated, not re-created.
model SyncedBookingEvent {
  id             String                @id @default(cuid())
  feed           PropertyCalendarFeed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  feedId         String
  externalUid    String
  checkIn        DateTime
  checkOut       DateTime
  clean          Clean?                @relation(fields: [cleanId], references: [id], onDelete: SetNull)
  cleanId        String?               @unique
  cancelled      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([feedId, externalUid])
}

// Same role as SyncedBookingEvent, but for reservations pulled from the
// Hostify API instead of an iCal feed -- keyed directly to Property since
// Hostify has no per-channel "feed" concept (one listing already aggregates
// every channel). Unlike iCal, cancellation is read from `status` rather
// than inferred from a booking disappearing from a re-fetched feed -- see
// src/lib/hostifySync.ts.
model SyncedHostifyReservation {
  id                   String    @id @default(cuid())
  property             Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId           String
  // String, not Int -- same reasoning as Property.hostifyListingId. Some
  // Hostify ids in the wild run well past 32-bit INT range.
  hostifyReservationId String
  // Raw Hostify status string ("accepted", "pending", "denied",
  // "cancelled_by_host", "cancelled_by_guest", "no_show", ...), stored as-is
  // rather than a Prisma enum so a future status value Hostify adds doesn't
  // fail an insert -- see the status-mapping step in hostifySync.ts.
  status               String
  checkIn              DateTime
  checkOut             DateTime
  guests               Int?
  clean                Clean?    @relation(fields: [cleanId], references: [id], onDelete: SetNull)
  cleanId              String?   @unique
  cancelled            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([propertyId, hostifyReservationId])
}

// WHAT is wrong, as the cleaner sees it -- deliberately factual and specific
// ("no hot water", "lock or key safe") rather than broad buckets, because
// the category is what the system works severity out from (see
// assessIssueSeverity in src/lib/issues.ts). Cleaners report facts; they're
// never asked how urgent something is.
enum IssueCategory {
  SAFETY_HAZARD
  LEAK
  NO_WATER
  NO_POWER
  NO_HEATING
  TOILET
  ACCESS
  APPLIANCE
  PESTS
  BROKEN
  DAMAGE
  MISSING_ITEM
  LOST_PROPERTY
  OTHER
}

// How soon it needs dealing with, in the terms that actually drive the
// decision in a short-let: whether it has to be sorted before the next
// guests walk in. Deliberately three, not a 1-5 scale nobody applies
// consistently. Set by the system, never by whoever reported it -- see
// Issue.severityReason.
enum IssueSeverity {
  LOW
  MEDIUM
  URGENT
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// A problem found at a property -- damage, something broken, something
// missing, a guest's forgotten belongings. Usually reported by the cleaner
// mid-turnover (cleanId set, with photos as evidence for a damage claim),
// but staff can log one too (a guest complaint, say), with no clean behind
// it. Tracked through to resolution rather than just being a line in a
// clean's notes, so nothing reported gets quietly forgotten.
//
// reportedBy/resolvedBy are nullable with SetNull for the same reason as
// AuditLog.actor -- removing a person shouldn't erase what they reported.
// The clean link is SetNull too: deleting a clean doesn't make the broken
// boiler it turned up any less broken.
model Issue {
  id             String        @id @default(cuid())
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId     String
  clean          Clean?        @relation(fields: [cleanId], references: [id], onDelete: SetNull)
  cleanId        String?
  reportedBy     User?         @relation("IssueReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedById   String?
  category       IssueCategory
  severity       IssueSeverity
  // Why the system gave it that severity, in words staff can check at a
  // glance ("No water — guests can't stay without it"). Kept even after a
  // staff override, as the record of what the automatic assessment said.
  severityReason String?
  // True once staff have changed the severity by hand -- triage is theirs to
  // correct; the audit log records who and when.
  severityOverridden Boolean   @default(false)
  description    String
  status         IssueStatus   @default(OPEN)
  // What was done about it -- set (optionally) when marking it resolved.
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedBy     User?         @relation("IssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById   String?
  photos         IssuePhoto[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([propertyId, status])
  @@index([status])
  @@index([cleanId])
}

// Evidence photos for an issue. Stored under the same
// storage/property-photos/{propertyId}/ root as every other property photo,
// so /api/photos's single per-property access check covers these too.
model IssuePhoto {
  id        String   @id @default(cuid())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId   String
  path      String
  createdAt DateTime @default(now())

  @@index([issueId])
}

// A property-specific addition to the standard turnover checklist
// (CLEANING_CHECKLIST in src/lib/cleaningChecklist.ts) -- "hot tub: check
// chemicals", "garden furniture back under cover". Additions only: the
// standard list is the business's baseline for what "done" means
// everywhere, and a property adds what's particular to it on top rather
// than replacing that. An item whose room matches a standard room joins
// that room's card; any other room becomes a card of its own.
model PropertyChecklistItem {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  room       String
  text       String
  createdAt  DateTime @default(now())

  @@index([propertyId])
}
